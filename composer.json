{
    "name": "kbk/nepali-payment-gateway",
    "version": "1.0.2",
    "type": "library",
    "description": "Nepali Payment Gateway integration in PHP language. It includes eSewa, Khalti, ConnectIps, etc.",
    "license": "MIT",
    "homepage": "https://github.com/aryanmalla19/nepali-payment-gateway",
    "keywords": [
        "PHP",
        "API",
        "eSewa",
        "Khalti",
        "ConnectIps",
        "Payment",
        "Gateway",
        "Nepal"
    ],
    "autoload": {
        "psr-4": {
            "Kbk\\NepaliPaymentGateway\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Aryan Malla",
            "email": "aryanmalla19@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
      "ext-curl": "*",
      "ext-openssl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "mockery/mockery": "^1.6",
        "phpdocumentor/phpdocumentor": "^3.9",
        "friendsofphp/php-cs-fixer": "^3.92"
    },
    "config": {
        "discard-changes": true,
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "fix": "php-cs-fixer fix",
        "fix:dry": "php-cs-fixer fix --dry-run --diff"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
